<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.ilkay.redmigateway.ios</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Telefon Geçidi</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>2.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Görüşme sesi aktarımı etkinleştirildiğinde mikrofon kullanılır.</string>
    <key>NSContactsUsageDescription</key>
    <string>Rehberindeki kişileri uygulama içinde göstermek, aramak ve SMS konuşmalarını adlarıyla eşleştirmek için kullanılır.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Redmi telefonuyla aynı Wi-Fi ağında arama ve SMS bilgilerini eşitlemek için yerel ağ erişimi gerekir.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Redmi hattına gelen aramaları iPhone kilitliyken de göstermek ve Redmi'yi hızlı bulmak için Bluetooth kullanılır.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_redmigateway._tcp</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>voip</string>
        <string>audio</string>
        <string>bluetooth-central</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
