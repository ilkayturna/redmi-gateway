<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Call Status Info -->
        <TextView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/contactPhoto"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Kişi fotoğrafı"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/contactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Call waiting: a second incoming call during this one -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/waitingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/status_attention"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/waitingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/waitingReject"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:minHeight="48dp"
                        android:text="Reddet" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/waitingAnswer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:minHeight="48dp"
                        android:text="Kapat ve yanıtla" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Audio Ownership Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/audioStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/border_neon_cyan"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/audioStatusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SES iPHONE'DA"
                    android:textColor="@color/neon_sky"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/audioStatusDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Görüşme bağlı iPhone üzerinden yapılıyor. Ahizedeki kısık ses geçit yönlendirmesindedir."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audioTransferButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sesi Redmi'ye Al"
                    android:textSize="13sp"
                    app:strokeColor="@color/neon_sky" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Incoming Call: Bidirectional Swipe Slider Container -->
        <LinearLayout
            android:id="@+id/incomingActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Yanıtlamak için sağa, reddetmek için sola kaydırın"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <!-- Slider Track -->
            <FrameLayout
                android:id="@+id/sliderTrack"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/slider_background"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/sliderRejectLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="◀ Reddet"
                        android:textColor="@color/status_bad"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sliderAnswerLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Yanıtla ▶"
                        android:textColor="@color/status_good"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Floating Handle -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sliderThumb"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:text="📞"
                    android:textSize="22sp"
                    app:cornerRadius="32dp"
                    app:backgroundTint="@color/neon_emerald" />
            </FrameLayout>

            <!-- Fallback Tap Buttons (for accessibility and testing) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reject"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Doğrudan Reddet"
                    android:textColor="@color/status_bad"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/answer"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Doğrudan Yanıtla"
                    android:textColor="@color/status_good"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active Call: Symmetrical 2x2 Control Grid -->
        <LinearLayout
            android:id="@+id/activeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mute"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Sessiz"
                    android:textSize="15sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/speaker"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Hoparlör"
                    android:textSize="15sp"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keypadToggle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Tuşlar"
                    android:textSize="15sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hangup"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Bitir"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_bad"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- In-Call DTMF Keypad View -->
        <LinearLayout
            android:id="@+id/dtmfContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/dtmf1" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="1" android:textSize="20sp" />
                <Button android:id="@+id/dtmf2" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="2" android:textSize="20sp" />
                <Button android:id="@+id/dtmf3" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="3" android:textSize="20sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/dtmf4" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="4" android:textSize="20sp" />
                <Button android:id="@+id/dtmf5" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="5" android:textSize="20sp" />
                <Button android:id="@+id/dtmf6" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="6" android:textSize="20sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/dtmf7" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="7" android:textSize="20sp" />
                <Button android:id="@+id/dtmf8" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="8" android:textSize="20sp" />
                <Button android:id="@+id/dtmf9" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="9" android:textSize="20sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/dtmfStar" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="*" android:textSize="20sp" />
                <Button android:id="@+id/dtmf0" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="0" android:textSize="20sp" />
                <Button android:id="@+id/dtmfHash" android:layout_width="64dp" android:layout_height="64dp" android:layout_margin="6dp" android:text="#" android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Help / Information Text -->
        <TextView
            android:id="@+id/help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
