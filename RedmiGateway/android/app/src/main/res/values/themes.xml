<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RedmiGateway" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/bg_void</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/bg_void</item>
        <item name="android:navigationBarColor">@color/bg_void</item>
        <item name="android:windowBackground">@color/bg_void</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Bottom navigation labels: 12sp, medium weight, no all-caps drift. -->
    <style name="TextAppearance.RedmiGateway.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.RedmiGateway.NavLabel.Active">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.RedmiGateway.Call" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_sky</item>
        <item name="colorPrimaryVariant">@color/call_bg_start</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/bg_call_gradient</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
