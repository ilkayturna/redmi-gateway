<?xml version="1.0" encoding="utf-8"?>
<!-- Dialpad key: flat circular surface with a hairline edge, ripple on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/pb_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/pb_key_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/pb_key_stroke" />
        </shape>
    </item>
</ripple>
